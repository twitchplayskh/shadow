#version 460
#extension GL_EXT_ray_query : require

// SoD-RT bridge self-test: two rays against a one-triangle TLAS.
// result[0] = 1 if the ray aimed at the triangle hits it, result[1] = 1 if the ray aimed away misses.

layout(local_size_x = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) buffer Result { uint result[4]; };

bool traceHit(vec3 origin, vec3 dir) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
                        0xFF, origin, 0.001, dir, 1000.0);
  while (rayQueryProceedEXT(rq)) { }
  return rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
}

void main() {
  // triangle lies in the z = 0 plane around the origin; rays start at z = -1
  result[0] = traceHit(vec3(0.0, 0.0, -1.0), vec3(0.0, 0.0,  1.0)) ? 1u : 0u;
  result[1] = traceHit(vec3(0.0, 0.0, -1.0), vec3(0.0, 0.0, -1.0)) ? 0u : 1u;
  result[2] = 0x5D5D5D5Du;   // marker: shader ran
}
