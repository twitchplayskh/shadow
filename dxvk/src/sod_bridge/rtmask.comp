#version 460
#extension GL_EXT_ray_query : require
// SoD-RT: ray-traced character shadows.
//
// Hard mode (RAY TRACING = MEDIUM, flags bit 1 clear): pass 0 only. One thread per 4 consecutive pixels (one
// result word). For every pixel with geometry (reversed Z: depth > 0) the world position is rebuilt from the
// depth buffer and one ray per light is traced towards that light. The TLAS holds one opaque instance per
// light (instance mask = 1 << light) with exactly the characters the game casts a shadow for with that light.
// Result byte: light factor, 255 = fully lit, else 255 * product(1 - density * occlusion) over the lights.
//
// Soft mode (HIGH / ULTRA, flags bit 1 set): the light gets an angular radius (tan in flags bits 16..31, 1e-4
// units), so the penumbra is narrow where the caster is close to the floor (feet) and widens with distance.
//   pass 0: hard ray per pixel as above, plus the per-light hit bits of every pixel
//   pass 1: per 8x8 tile: does the tile (plus a 1 px border) contain a change in hit bits (a shadow edge)?
//   pass 2: per tile: active = an edge tile within R tiles (R covers the widest penumbra)
//   pass 3: active spots: cone of rays per light (Vogel disk, per-pixel rotation; 4 rays first, the rest only
//           if those disagree), at half resolution above 1600 lines. Lamps (point lights) have a radius, so
//           their penumbra widens with the distance between caster and receiver
//   pass 4: active pixels: depth-aware upsample/filter of pass 3; where the soft samples agree the full-res
//           hard value is kept (fine detail); result + shadowed-pixel count
// Pixels outside active tiles are more than R tiles from any hard edge, so their cone result equals the hard
// one: the extra work is confined to the neighbourhood of shadow edges.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly  buffer Depth  { float depth[]; };
layout(std430, set = 0, binding = 1) buffer Result { uint result[]; };
layout(set = 0, binding = 2) uniform accelerationStructureEXT tlas;
layout(std430, set = 0, binding = 3) readonly buffer Frame {
  uint  magic, frame, width, height;
  float vpX, vpY, vpW, vpH;
  float invVP[16];                 // row-major, row vectors
  uint  lightCount, casterCount, triCount, flags;
  vec4  lights[8];                 // xyz: towards the light, w: density
  uvec4 casters[64];               // x: first tri, y: tri count, z: light mask
  vec4  boxes[8 * 3];              // per light: (u, uMin), (v, uMax), (vMin, vMax, lMax, -)
} f;
layout(std430, set = 0, binding = 4) buffer Counts { uint counts[]; };
layout(std430, set = 0, binding = 5) buffer Bits   { uint bits[]; };     // soft: hit bits, 1 byte per pixel
layout(std430, set = 0, binding = 6) buffer Soft   { uint soft[]; };     // soft: pass 3 output, 1 uint per soft pixel
layout(std430, set = 0, binding = 7) buffer Tiles  { uint tiles[]; };    // soft: [0, T) edge, [T, 2T) active
layout(push_constant) uniform PC { uint slot; uint pass_; } pc;

const float kBias = 1.0;           // world units (characters are ~1000 units tall)
const uint  kTile = 8u;

uint tilesX() { return (f.width + kTile - 1u) / kTile; }
uint tilesY() { return (f.height + kTile - 1u) / kTile; }
uint byteAt(uint w, uint k) { return (w >> (8u * k)) & 255u; }
uint bitsAt(uint p) { return byteAt(bits[p >> 2], p & 3u); }
bool activeAt(uint x, uint y) { return tiles[tilesX() * tilesY() + (y / kTile) * tilesX() + x / kTile] != 0u; }

vec3 worldPos(uint p, float d) {
  float px = float(p % f.width) + 0.5, py = float(p / f.width) + 0.5;
  vec4 h = vec4((px - f.vpX) / f.vpW * 2.0 - 1.0, 1.0 - (py - f.vpY) / f.vpH * 2.0, d, 1.0);
  vec4 w;
  for (int j = 0; j < 4; j++)
    w[j] = h.x * f.invVP[j] + h.y * f.invVP[4 + j] + h.z * f.invVP[8 + j] + h.w * f.invVP[12 + j];
  return w.xyz / w.w;
}

// point light (ceiling lamps): lights[l].xyz is the position, boxes[3l] = casters' bounding sphere, boxes[3l+2].w = 1
bool isPoint(uint l) { return f.boxes[l * 3u + 2u].w > 0.5; }

// direction towards light l from pos, and the ray length (to the lamp, or "infinite" for a parallel light)
vec3 lightDir(uint l, vec3 pos, out float tmax) {
  if (isPoint(l)) { vec3 t = f.lights[l].xyz - pos; float d = length(t); tmax = max(d - 1.0, 0.5); return t / max(d, 1e-6); }
  tmax = 100000.0; return f.lights[l].xyz;
}

// can a ray from pos towards light l, tilted by at most `spread` (tan), hit a caster of light l?
bool mayHit(uint l, vec3 pos, float spread) {
  if (isPoint(l)) {
    vec4 s = f.boxes[l * 3u];
    if (s.w < 0.0) return false;
    vec3 Lp = f.lights[l].xyz, seg = Lp - pos;
    float len2 = max(dot(seg, seg), 1e-6);
    float t = clamp(dot(s.xyz - pos, seg) / len2, 0.0, 1.0);
    float dist = length(pos + seg * t - s.xyz);
    return dist <= s.w + 1.0 + sqrt(len2) * t * spread * 1.01;
  }
  vec3 L = f.lights[l].xyz;
  vec4 b0 = f.boxes[l * 3u], b1 = f.boxes[l * 3u + 1u], b2 = f.boxes[l * 3u + 2u];
  float pl = dot(pos, L);
  if (pl > b2.z + 1.0) return false;
  float m = 1.0 + (b2.z - pl) * spread * 1.01;   // sideways drift until the ray is past the highest caster
  float pu = dot(pos, b0.xyz), pv = dot(pos, b1.xyz);
  return !(pu < b0.w - m || pu > b1.w + m || pv < b2.x - m || pv > b2.y + m);
}

bool occluded(uint l, vec3 pos, vec3 dir, float tmax) {
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 1u << l,
                        pos + dir * kBias, 0.5, dir, tmax);
  rayQueryProceedEXT(rq);
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

uint toByte(float lit) { return uint(clamp(lit * 255.0 + 0.5, 0.0, 255.0)); }

// ---- pass 0: one hard ray per light (+ hit bits in soft mode)
void passHard(uint word, uint n, bool softMode) {
  uint packed = 0u, hb = 0u, shadowed = 0u;
  for (uint k = 0u; k < 4u; k++) {
    uint p = word * 4u + k;
    uint lit8 = 255u, b = 0u;
    if (p < n) {
      float d = depth[p];
      if (d > 0.0 && d <= 1.0) {
        vec3 pos = worldPos(p, d);
        float lit = 1.0;
        for (uint l = 0u; l < f.lightCount && l < 8u; l++) {
          if (!mayHit(l, pos, 0.0)) continue;
          float tmax; vec3 dir = lightDir(l, pos, tmax);
          if (occluded(l, pos, dir, tmax)) { lit *= 1.0 - f.lights[l].w; b |= 1u << l; }
        }
        lit8 = toByte(lit);
      }
    }
    if (lit8 != 255u && p < n) shadowed++;
    packed |= lit8 << (8u * k);
    hb |= b << (8u * k);
  }
  result[word] = packed;
  if (softMode) bits[word] = hb;
  else if (shadowed > 0u) atomicAdd(counts[pc.slot], shadowed);
}

// ---- pass 1: edge tiles
void passEdges(uint t) {
  uint tx = t % tilesX(), ty = t / tilesX();
  int x0 = int(tx * kTile) - 1, y0 = int(ty * kTile) - 1;
  uint first = 0xFFFFFFFFu; bool edge = false;
  for (int y = y0; y <= y0 + int(kTile) + 1 && !edge; y++) {
    if (y < 0 || y >= int(f.height)) continue;
    for (int x = x0; x <= x0 + int(kTile) + 1; x++) {
      if (x < 0 || x >= int(f.width)) continue;
      uint b = bitsAt(uint(y) * f.width + uint(x));
      if (first == 0xFFFFFFFFu) first = b; else if (b != first) { edge = true; break; }
    }
  }
  tiles[t] = edge ? 1u : 0u;
}

// soft pass resolution: half (2x2 blocks) above 1600 lines, so 4K costs about what 1440p would; the
// upsample in pass 4 keeps the full-resolution hard result wherever the soft result is uniform (fine detail)
uint softScale() { return f.height > 1600u ? 2u : 1u; }
uint softW() { return (f.width + softScale() - 1u) / softScale(); }
uint softH() { return (f.height + softScale() - 1u) / softScale(); }

bool anyPoint() { for (uint l = 0u; l < f.lightCount && l < 8u; l++) if (isPoint(l)) return true; return false; }

// widest penumbra (pixels, either side of the hard edge) the active band covers: height * tan for distant
// lights (the 1/40 of the screen measured on frame 2635 at tan 0.025), 1/30 of the screen when lamps are
// present (their penumbra grows with distance; beyond the band it is clipped, which only shows on very
// long, faint lamp shadows), plus the reach of the upsample
int bandTiles() {
  float spread = float(f.flags >> 16) * 1e-4;
  uint px = uint(float(f.height) * spread);
  if (anyPoint()) px = max(px, f.height / 30u);
  px += 3u * softScale() + 2u;
  return int((px + kTile - 1u) / kTile);
}

// ---- pass 2: dilate the edge tiles; an active tile stores 1 + its distance (in tiles) to the nearest edge tile
void passDilate(uint t) {
  int tx = int(t % tilesX()), ty = int(t / tilesX()), r = bandTiles();
  int best = r + 1;
  for (int y = max(ty - r, 0); y <= min(ty + r, int(tilesY()) - 1); y++)
    for (int x = max(tx - r, 0); x <= min(tx + r, int(tilesX()) - 1); x++)
      if (tiles[uint(y) * tilesX() + uint(x)] != 0u) best = min(best, max(abs(x - tx), abs(y - ty)));
  tiles[tilesX() * tilesY() + t] = best <= r ? uint(best) + 1u : 0u;
}
uint edgeDistAt(uint x, uint y) { return tiles[tilesX() * tilesY() + (y / kTile) * tilesX() + x / kTile] - 1u; }

// world position of screen point (px, py) at depth d
vec3 worldAt(float px, float py, float d) {
  vec4 h = vec4((px - f.vpX) / f.vpW * 2.0 - 1.0, 1.0 - (py - f.vpY) / f.vpH * 2.0, d, 1.0);
  vec4 w;
  for (int j = 0; j < 4; j++)
    w[j] = h.x * f.invVP[j] + h.y * f.invVP[4 + j] + h.z * f.invVP[8 + j] + h.w * f.invVP[12 + j];
  return w.xyz / w.w;
}

// angular size of light l seen from pos (tan): distant lights use the global setting; lamps have a radius
// (boxes[3l+1].x), so their penumbra is narrow where the caster touches the receiver and widens with distance
float spreadOf(uint l, vec3 pos, float globalSpread) {
  if (!isPoint(l)) return globalSpread;
  float R = f.boxes[l * 3u + 1u].x;
  return max(globalSpread, min(R / max(length(f.lights[l].xyz - pos), 1.0), 0.5));
}

// any pixel within Chebyshev radius r of (x, y) whose hard hit bits differ from (x, y)'s?
bool changeWithin(uint x, uint y, int r) {
  uint own = bitsAt(y * f.width + x);
  int x0 = max(int(x) - r, 0), x1 = min(int(x) + r, int(f.width) - 1);
  int y0 = max(int(y) - r, 0), y1 = min(int(y) + r, int(f.height) - 1);
  uint ownRep = own * 0x01010101u;
  for (int yy = y0; yy <= y1; yy++) {
    uint row = uint(yy) * f.width;
    uint p0 = row + uint(x0), p1 = row + uint(x1);
    for (uint w = p0 >> 2; w <= (p1 >> 2); w++) {
      uint diff = bits[w] ^ ownRep;
      if (diff == 0u) continue;
      for (uint k = 0u; k < 4u; k++) {
        uint q = w * 4u + k;
        if (q >= p0 && q <= p1 && ((diff >> (8u * k)) & 255u) != 0u) return true;
      }
    }
  }
  return false;
}

// ---- pass 3: cone of rays near the edges, one sample per soft pixel (softScale x softScale block)
// soft[i]: bits 0..8 soft value (256 = not traced), bits 16..23 the hard value at that spot
void passCone(uint id) {
  uint sc = softScale(), sw = softW();
  if (id >= sw * softH()) return;
  uint x = min((id % sw) * sc, f.width - 1u), y = min((id / sw) * sc, f.height - 1u), p = y * f.width + x;
  uint hard = byteAt(result[p >> 2], p & 3u), v = 256u;
  uint samples = clamp((f.flags >> 8) & 255u, 4u, 64u);
  float gspread = float(f.flags >> 16) * 1e-4;
  float d = depth[p];
  bool reach = false;
  vec3 pos = vec3(0.0);
  if (activeAt(x, y) && d > 0.0 && d <= 1.0) {
    // Can this pixel be in a penumbra at all? A cone ray drifts sideways by at most (distance to the farthest
    // caster) x (cone angle); on screen that is at most rW / (size of one pixel there) pixels. The pixel needs
    // rays only if a hard shadow edge (an edge tile) is within that reach (+ the upsample's reach); otherwise
    // every ray of its cone agrees with the hard result it already has. The band of pass 2 is sized for the
    // worst case on the whole screen; this sizes it per pixel (small around the feet, wider up the body).
    pos = worldPos(p, d);
    float pw = max(length(worldAt(float(x) + 1.5, float(y) + 0.5, d) - pos), 1e-4);
    // the receiver's facing (from the depth of the neighbours): a cone ray's sideways drift lands on a surface
    // the light grazes stretched by 1 / cos(incidence)
    uint xn = x + 1u < f.width ? x + 1u : x - 1u, yn = y + 1u < f.height ? y + 1u : y - 1u;
    float dx = depth[y * f.width + xn], dy = depth[yn * f.width + x];
    vec3 nrm = vec3(0.0);
    if (dx > 0.0 && dy > 0.0) nrm = cross(worldPos(y * f.width + xn, dx) - pos, worldPos(yn * f.width + x, dy) - pos);
    float nl = length(nrm);
    float gspread0 = float(f.flags >> 16) * 1e-4, rW = 0.0;
    for (uint l = 0u; l < f.lightCount && l < 8u; l++) {
      float sp = spreadOf(l, pos, gspread0);
      if (!mayHit(l, pos, sp)) continue;
      float tm;
      if (isPoint(l)) { vec4 bs = f.boxes[l * 3u]; tm = length(bs.xyz - pos) + bs.w; }
      else tm = max(f.boxes[l * 3u + 2u].z - dot(pos, f.lights[l].xyz), 0.0);
      vec3 Ld = isPoint(l) ? normalize(f.lights[l].xyz - pos) : f.lights[l].xyz;
      float cosI = nl > 0.0 ? abs(dot(nrm / nl, Ld)) : 0.0;
      rW = max(rW, tm * sp / max(cosI, 0.1));
    }
    float rPx = rW / pw + 1.5;
    reach = rW > 0.0 && float(int(edgeDistAt(x, y)) - 1) * float(kTile) <= rPx;
    // close range: look for an actual hard-shadow change (hit bits differ) within the reach, pixel by pixel
    if (reach && rPx <= 24.0) reach = changeWithin(x, y, int(ceil(rPx)));
  }
  if (reach) {
    // per-pixel rotation of the sample disk (interleaved gradient noise); the filter in pass 4 removes it
    float rot = 6.2831853 * fract(52.9829189 * fract(0.06711056 * float(id % sw) + 0.00583715 * float(id / sw)));
    float lit = 1.0;
    for (uint l = 0u; l < f.lightCount && l < 8u; l++) {
      float spread = spreadOf(l, pos, gspread);
      if (!mayHit(l, pos, spread)) continue;
      float tmax; vec3 L = lightDir(l, pos, tmax);
      vec3 a = abs(L.x) > 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
      vec3 u = normalize(cross(L, a)), w = cross(L, u);
      uint hits = 0u, done = 0u;
      for (uint i = 0u; i < samples; i++) {
        if (i == 4u && (hits == 0u || hits == 4u)) break;    // first 4 agree: not in the penumbra
        float r = sqrt((float(i) + 0.5) / float(samples)) * spread;
        float ang = float(i) * 2.3999632 + rot;
        vec3 dir = normalize(L + (u * cos(ang) + w * sin(ang)) * r);
        if (occluded(l, pos, dir, tmax)) hits++;
        done++;
      }
      lit *= 1.0 - f.lights[l].w * float(hits) / float(done);
    }
    v = toByte(lit);
  }
  soft[id] = v | (hard << 16);
}

// ---- pass 4: depth-aware upsample + filter of the soft samples (active pixels), final result + count.
// Where the soft samples around a pixel all agree (fully lit, or the same full shadow) the pixel keeps its
// own full-resolution hard value, so thin details (gaps between fingers) stay crisp.
void passBlur(uint word, uint n) {
  uint sc = softScale(), sw = softW(), sh = softH();
  uint packed = 0u, shadowed = 0u, own = result[word];
  for (uint k = 0u; k < 4u; k++) {
    uint p = word * 4u + k;
    uint v = byteAt(own, k);
    if (p < n) {
      uint x = p % f.width, y = p / f.width;
      float dc = depth[p];
      if (activeAt(x, y) && dc > 0.0) {
        float fx = (float(x) + 0.5) / float(sc) - 0.5, fy = (float(y) + 0.5) / float(sc) - 0.5;
        int cx = int(floor(fx + 0.5)), cy = int(floor(fy + 0.5));
        float sum = 0.0, wsum = 0.0; uint lo = 255u, hi = 0u;
        for (int j = -1; j <= 1; j++)
          for (int i = -1; i <= 1; i++) {
            int sx = cx + i, sy = cy + j;
            if (sx < 0 || sy < 0 || sx >= int(sw) || sy >= int(sh)) continue;
            uint qx = min(uint(sx) * sc, f.width - 1u), qy = min(uint(sy) * sc, f.height - 1u);
            float dq = depth[qy * f.width + qx];
            if (dq <= 0.0) continue;
            uint e = soft[uint(sy) * sw + uint(sx)];
            uint sv = (e & 0x1FFu) == 256u ? (e >> 16) & 255u : e & 255u;
            float rel = abs(dq / dc - 1.0) * 100.0;          // reversed Z ~ 1/z: relative distance, in %
            float ddx = float(sx) - fx, ddy = float(sy) - fy;
            float wgt = exp(-0.7 * (ddx * ddx + ddy * ddy)) / (1.0 + rel * rel);
            if (wgt < 0.02) continue;
            sum += wgt * float(sv); wsum += wgt; lo = min(lo, sv); hi = max(hi, sv);
          }
        if (wsum > 0.0 && lo != hi) v = uint(clamp(sum / wsum + 0.5, 0.0, 255.0));
      }
      if (v != 255u) shadowed++;
    }
    packed |= v << (8u * k);
  }
  result[word] = packed;
  if (shadowed > 0u) atomicAdd(counts[pc.slot], shadowed);
}

void main() {
  uint id = gl_GlobalInvocationID.x;
  uint n = f.width * f.height, words = (n + 3u) / 4u, ntiles = tilesX() * tilesY();
  bool softMode = (f.flags & 2u) != 0u;
  if (pc.pass_ == 0u) { if (id < words) passHard(id, n, softMode); }
  else if (pc.pass_ == 1u) { if (id < ntiles) passEdges(id); }
  else if (pc.pass_ == 2u) { if (id < ntiles) passDilate(id); }
  else if (pc.pass_ == 3u) passCone(id);
  else if (pc.pass_ == 4u) { if (id < words) passBlur(id, n); }
}
