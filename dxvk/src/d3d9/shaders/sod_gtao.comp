#version 450
// SoD ambient occlusion (GTAO, after Jimenez et al. 2016 / Intel XeGTAO) from the game's own depth buffer.
// pass 0: half resolution, one invocation per half-res pixel: visibility + view depth -> aoBuf
// pass 1: full resolution, one invocation per 4 pixels: depth-aware 4x4 resolve (removes the 4x4 noise pattern),
//         fog / distance fade, strength -> 1 byte per pixel (255 = untouched) for the multiply pass
// Depth: float copy of the game's D24S8 buffer. The game's projection (fixed function) is reversed:
// d = P10 + P14 / z (cleared to 0 = far), so view z = P14 / (d - P10).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer DepthBuf { float depth[]; };
layout(binding = 1, std430) buffer AoBuf { vec2 ao[]; };
layout(binding = 2, std430) writeonly buffer OutBuf { uint outp[]; };

layout(push_constant) uniform PC {
  uvec4 size;    // W, H, half W, half H
  vec4  proj;    // P0, P5, P10, P14
  vec4  vp;      // viewport x, y, w, h (pixels)
  vec4  par;     // radius (view units), strength, power, max radius (pixels)
  vec4  fog;     // fog start, fog end, fog on, distance fade start (view z, 0 = none)
  uvec4 cfg;     // slices, steps, pass, debug
} pc;

const float PI = 3.14159265;
const float HALF_PI = 1.5707963;

bool validDepth(float d) { return d > 1e-7 && d <= 1.0; }

float viewZ(float d) { return pc.proj.w / (d - pc.proj.z); }

vec3 viewPos(vec2 pix, float d) {          // pix: full-res pixel centre coordinates
  float z = viewZ(d);
  vec2 ndc = vec2((pix.x - pc.vp.x) / pc.vp.z * 2.0 - 1.0, 1.0 - (pix.y - pc.vp.y) / pc.vp.w * 2.0);
  return vec3(ndc.x * z / pc.proj.x, ndc.y * z / pc.proj.y, z);
}

float fetchDepth(ivec2 p) {
  p = clamp(p, ivec2(0), ivec2(pc.size.xy) - 1);
  return depth[uint(p.y) * pc.size.x + uint(p.x)];
}

float fastAcos(float x) {
  float a = abs(x);
  float r = -0.156583 * a + HALF_PI;
  r *= sqrt(1.0 - a);
  return x >= 0.0 ? r : PI - r;
}

const float bayer[16] = float[16](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);

void passGtao(uvec2 h) {
  if (h.x >= pc.size.z || h.y >= pc.size.w) return;
  uint idx = h.y * pc.size.z + h.x;
  ivec2 c = ivec2(h * 2u);
  float d = fetchDepth(c);
  if (!validDepth(d)) { ao[idx] = vec2(1.0, -1.0); return; }
  vec2 cp = vec2(c) + 0.5;
  vec3 P = viewPos(cp, d);
  vec3 V = normalize(-P);

  // normal from depth: per axis the neighbour with the smaller depth step (no smearing across edges)
  float dl = fetchDepth(c + ivec2(-1, 0)), dr = fetchDepth(c + ivec2(1, 0));
  float du = fetchDepth(c + ivec2(0, -1)), dd = fetchDepth(c + ivec2(0, 1));
  vec3 Pl = viewPos(cp + vec2(-1, 0), validDepth(dl) ? dl : d), Pr = viewPos(cp + vec2(1, 0), validDepth(dr) ? dr : d);
  vec3 Pu = viewPos(cp + vec2(0, -1), validDepth(du) ? du : d), Pd = viewPos(cp + vec2(0, 1), validDepth(dd) ? dd : d);
  vec3 dx = abs(Pr.z - P.z) < abs(P.z - Pl.z) ? Pr - P : P - Pl;
  vec3 dy = abs(Pd.z - P.z) < abs(P.z - Pu.z) ? Pd - P : P - Pu;
  vec3 N = normalize(cross(dx, dy));
  if (dot(N, V) < 0.0) N = -N;

  float R = pc.par.x;
  float pxPerUnit = 0.5 * pc.vp.z * abs(pc.proj.x) / P.z;
  float screenR = R * pxPerUnit;
  if (screenR < 1.0) { ao[idx] = vec2(1.0, P.z); return; }
  screenR = min(screenR, pc.par.w);
  float minS = 1.3 / screenR;

  float falloffRange = 0.615 * R;
  float falloffMul = -1.0 / falloffRange;
  float falloffAdd = (R * (1.0 - 0.615)) / falloffRange + 1.0;

  uint k = (h.y & 3u) * 4u + (h.x & 3u);
  float noiseSlice = (bayer[k] + 0.5) / 16.0;
  float noiseStep = fract(noiseSlice * 3.0 + 0.37);

  uint slices = max(pc.cfg.x, 1u), steps = max(pc.cfg.y, 1u);
  float vis = 0.0;
  for (uint s = 0u; s < slices; s++) {
    float phi = (float(s) + noiseSlice) * PI / float(slices);
    vec2 omega = vec2(cos(phi), sin(phi));                 // screen pixels, y down
    vec3 dirV = normalize(vec3(omega.x * 2.0 / (pc.vp.z * pc.proj.x), -omega.y * 2.0 / (pc.vp.w * pc.proj.y), 0.0));
    vec3 orthoDir = dirV - dot(dirV, V) * V;
    vec3 axis = normalize(cross(orthoDir, V));
    vec3 projN = N - axis * dot(N, axis);
    float projLen = length(projN);
    float signN = sign(dot(orthoDir, projN));
    float cosN = clamp(dot(projN, V) / max(projLen, 1e-5), 0.0, 1.0);
    float n = signN * fastAcos(cosN);
    float low0 = cos(n + HALF_PI), low1 = cos(n - HALF_PI);
    float hc0 = low0, hc1 = low1;
    for (uint j = 0u; j < steps; j++) {
      float t = (float(j) + noiseStep) / float(steps);
      t = t * t + minS;
      vec2 off = round(omega * t * screenR);
      for (int side = 0; side < 2; side++) {
        vec2 sp = cp + (side == 0 ? off : -off);
        if (sp.x < pc.vp.x || sp.y < pc.vp.y || sp.x >= pc.vp.x + pc.vp.z || sp.y >= pc.vp.y + pc.vp.w) continue;
        float sd = fetchDepth(ivec2(sp));
        if (!validDepth(sd)) continue;
        vec3 delta = viewPos(sp, sd) - P;
        float dist = length(delta);
        if (dist < 1e-4) continue;
        float shc = dot(delta / dist, V);
        float w = clamp(dist * falloffMul + falloffAdd, 0.0, 1.0);
        if (side == 0) hc0 = max(hc0, mix(low0, shc, w));
        else           hc1 = max(hc1, mix(low1, shc, w));
      }
    }
    float h0 = -fastAcos(hc1), h1 = fastAcos(hc0);
    h0 = n + clamp(h0 - n, -HALF_PI, HALF_PI);
    h1 = n + clamp(h1 - n, -HALF_PI, HALF_PI);
    float sn = sin(n);
    float a0 = (cosN + 2.0 * h0 * sn - cos(2.0 * h0 - n)) * 0.25;
    float a1 = (cosN + 2.0 * h1 * sn - cos(2.0 * h1 - n)) * 0.25;
    vis += projLen * (a0 + a1);
  }
  vis = clamp(vis / float(slices), 0.0, 1.0);
  vis = pow(vis, pc.par.z);
  ao[idx] = vec2(vis, P.z);
}

float resolve(uint x, uint y) {
  float d = fetchDepth(ivec2(x, y));
  if (!validDepth(d)) return 1.0;
  float z = viewZ(d);
  int bx = int(x >> 1u) - 1, by = int(y >> 1u) - 1;
  float sum = 0.0, wsum = 0.0, nearest = 1.0, best = 1e30;
  for (int j = 0; j < 4; j++)
    for (int i = 0; i < 4; i++) {
      ivec2 q = clamp(ivec2(bx + i, by + j), ivec2(0), ivec2(pc.size.zw) - 1);
      vec2 s = ao[uint(q.y) * pc.size.z + uint(q.x)];
      if (s.y <= 0.0) continue;
      float rel = abs(s.y - z) / z;
      if (rel < best) { best = rel; nearest = s.x; }
      float w = exp(-rel * 40.0);
      sum += s.x * w; wsum += w;
    }
  float a = wsum > 1e-3 ? sum / wsum : nearest;
  if (pc.fog.z > 0.5 && pc.fog.y > pc.fog.x) a = mix(1.0, a, clamp((pc.fog.y - z) / (pc.fog.y - pc.fog.x), 0.0, 1.0));
  if (pc.fog.w > 0.0) a = mix(a, 1.0, clamp((z - pc.fog.w) / pc.fog.w, 0.0, 1.0));
  return mix(1.0, a, pc.par.y);
}

void main() {
  uvec2 g = gl_GlobalInvocationID.xy;
  if (pc.cfg.z == 0u) { passGtao(g); return; }
  uint W = pc.size.x, H = pc.size.y;
  if (g.y >= H || g.x * 4u >= W) return;
  uint packed = 0u;
  for (uint i = 0u; i < 4u; i++) {
    uint x = g.x * 4u + i;
    float v = x < W ? resolve(x, g.y) : 1.0;
    packed |= uint(clamp(v, 0.0, 1.0) * 255.0 + 0.5) << (8u * i);
  }
  outp[(g.y * W + g.x * 4u) / 4u] = packed;
}
