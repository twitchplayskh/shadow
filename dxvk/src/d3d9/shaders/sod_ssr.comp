#version 450
// SoD screen-space reflections on the surfaces tagged in SoDFix\reflect.txt (polished stone, wood, metal).
// Inputs: float copy of the game's depth (reversed: d = P10 + P14 / z), the frame so far (B8G8R8A8), and the
// reflectivity mask our replay pass drew with the floors' own UVs (R = strength, G = roughness).
// Output: B8G8R8A8 colour + alpha, blended over the frame (SRCALPHA / INVSRCALPHA) before see-through effects.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer DepthBuf { float depth[]; };
layout(binding = 1, std430) readonly buffer ColorBuf { uint color[]; };
layout(binding = 2, std430) readonly buffer MaskBuf  { uint mask[]; };
layout(binding = 3, std430) writeonly buffer OutBuf  { uint outp[]; };

layout(push_constant) uniform PC {
  uvec4 size;    // W, H, steps, refine steps (bit 31: resolve pass)
  vec4  proj;    // P0, P5, P10, P14
  vec4  vp;      // viewport x, y, w, h
  vec4  par;     // max ray length (view units), thickness, strength scale, near plane
  vec4  fog;     // start, end, on, debug
} pc;

bool validDepth(float d) { return d > 1e-7 && d <= 1.0; }
float viewZ(float d) { return pc.proj.w / (d - pc.proj.z); }
vec3 viewPos(vec2 pix, float z) {
  vec2 ndc = vec2((pix.x - pc.vp.x) / pc.vp.z * 2.0 - 1.0, 1.0 - (pix.y - pc.vp.y) / pc.vp.w * 2.0);
  return vec3(ndc.x * z / pc.proj.x, ndc.y * z / pc.proj.y, z);
}
vec2 project(vec3 q) {
  vec2 ndc = vec2(q.x * pc.proj.x / q.z, q.y * pc.proj.y / q.z);
  return vec2(pc.vp.x + (ndc.x + 1.0) * 0.5 * pc.vp.z, pc.vp.y + (1.0 - ndc.y) * 0.5 * pc.vp.w);
}
float fetchDepth(ivec2 p) {
  p = clamp(p, ivec2(0), ivec2(pc.size.xy) - 1);
  return depth[uint(p.y) * pc.size.x + uint(p.x)];
}
vec3 fetchColor(ivec2 p) {
  p = clamp(p, ivec2(0), ivec2(pc.size.xy) - 1);
  uint c = color[uint(p.y) * pc.size.x + uint(p.x)];
  return vec3(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u)) / 255.0;
}


// resolve: binding 1 holds the raw trace (same packing as the output). Depth-aware 5x5 average, so the
// per-pixel jitter of the march does not show as a fine screen-door pattern; alpha averages over all taps
// (misses count as 0), which also softens the edges of reflected objects.
void resolve(uvec2 g) {
  uint W = pc.size.x;
  uint i = g.y * W + g.x;
  if (((mask[i] >> 16) & 255u) == 0u) { outp[i] = 0u; return; }
  float d0 = depth[i];
  float z0 = viewZ(d0);
  vec3 col = vec3(0.0); float wc = 0.0, a = 0.0, wa = 0.0;
  int st = pc.vp.w > 1400.0 ? 2 : 1;            // 4K: the same footprint in 1080p pixels
  for (int y = -2; y <= 2; y++)
    for (int x = -2; x <= 2; x++) {
      ivec2 p = clamp(ivec2(g) + ivec2(x, y) * st, ivec2(0), ivec2(pc.size.xy) - 1);
      uint j = uint(p.y) * W + uint(p.x);
      if (((mask[j] >> 16) & 255u) == 0u) continue;
      float dj = depth[j];
      if (!validDepth(dj)) continue;
      float w = exp(-float(x * x + y * y) * 0.18) * clamp(1.0 - abs(viewZ(dj) - z0) / (0.02 * z0 + 4.0), 0.0, 1.0);
      if (w <= 0.0) continue;
      uint c = color[j];
      float aj = float(c >> 24) / 255.0;
      col += vec3(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u)) / 255.0 * w * aj;
      wc += w * aj; a += aj * w; wa += w;
    }
  if (wc <= 0.0 || wa <= 0.0) { outp[i] = 0u; return; }
  col /= wc; a /= wa;
  uint ai = uint(clamp(a, 0.0, 1.0) * 255.0 + 0.5);
  uvec3 ci = uvec3(clamp(col, 0.0, 1.0) * 255.0 + 0.5);
  outp[i] = ci.b | (ci.g << 8u) | (ci.r << 16u) | (ai << 24u);
}

void main() {
  uvec2 g = gl_GlobalInvocationID.xy;
  uint W = pc.size.x, H = pc.size.y;
  if (g.x >= W || g.y >= H) return;
  if ((pc.size.w & 0x80000000u) != 0u) { resolve(g); return; }
  uint i = g.y * W + g.x;
  uint m = mask[i];
  float strength = float((m >> 16) & 255u) / 255.0;
  float rough = float((m >> 8) & 255u) / 255.0;
  float d = depth[i];
  if (strength <= 0.0 || !validDepth(d)) { outp[i] = 0u; return; }

  ivec2 c = ivec2(g);
  vec2 cp = vec2(c) + 0.5;
  vec3 P = viewPos(cp, viewZ(d));
  // normal from depth: per axis the neighbour with the smaller depth step
  float dl = fetchDepth(c + ivec2(-1, 0)), dr = fetchDepth(c + ivec2(1, 0));
  float du = fetchDepth(c + ivec2(0, -1)), dd = fetchDepth(c + ivec2(0, 1));
  vec3 Pl = viewPos(cp + vec2(-1, 0), viewZ(validDepth(dl) ? dl : d)), Pr = viewPos(cp + vec2(1, 0), viewZ(validDepth(dr) ? dr : d));
  vec3 Pu = viewPos(cp + vec2(0, -1), viewZ(validDepth(du) ? du : d)), Pd = viewPos(cp + vec2(0, 1), viewZ(validDepth(dd) ? dd : d));
  vec3 dx = abs(Pr.z - P.z) < abs(P.z - Pl.z) ? Pr - P : P - Pl;
  vec3 dy = abs(Pd.z - P.z) < abs(P.z - Pu.z) ? Pd - P : P - Pu;
  vec3 N = normalize(cross(dx, dy));
  vec3 V = normalize(P);                         // eye -> surface
  if (dot(N, V) > 0.0) N = -N;
  vec3 R = reflect(V, N);

  // interleaved gradient noise: decorrelates the start of the march between neighbours without a visible grid
  float jitter = fract(52.9829189 * fract(dot(vec2(g), vec2(0.06711056, 0.00583715))));
  uint steps = max(pc.size.z, 1u);
  float maxT = pc.par.x;
  float tPrev = 0.0, tHit = -1.0, zPrev = P.z;
  for (uint j = 1u; j <= steps; j++) {
    float s = (float(j) - 1.0 + jitter) / float(steps);
    float t = maxT * pow(s, 1.6) + 2.0;          // 0.13.7: denser far steps (was s^2): thin stems and leaves are hit
    vec3 Q = P + R * t;
    if (Q.z < pc.par.w) break;                   // behind the near plane
    vec2 sp = project(Q);
    if (sp.x < pc.vp.x || sp.y < pc.vp.y || sp.x >= pc.vp.x + pc.vp.z || sp.y >= pc.vp.y + pc.vp.w) break;
    float sd = fetchDepth(ivec2(sp));
    if (validDepth(sd)) {
      float dz = Q.z - viewZ(sd);
      // the ray crossed the surface within this segment (plus the assumed object thickness)
      float thick = max(pc.par.y, 0.02 * Q.z) + abs(Q.z - zPrev);   // 0.13.8: characters and legs are ~100+ deep
      if (dz > 0.0 && dz < thick) { tHit = t; break; }
      // 0.13.8: a ray that passes behind an object (legs, table legs) keeps going: what it reaches beyond is
      // usually what the floor really reflects there, and stopping it left dark halos around characters
    }
    tPrev = t; zPrev = Q.z;
  }
  if (tHit < 0.0) { outp[i] = 0u; return; }
  // refine between the last miss and the hit
  float lo = tPrev, hi = tHit;
  for (uint k = 0u; k < pc.size.w; k++) {
    float mid = 0.5 * (lo + hi);
    vec3 Q = P + R * mid;
    float sd = fetchDepth(ivec2(project(Q)));
    if (validDepth(sd) && Q.z - viewZ(sd) > 0.0) hi = mid; else lo = mid;
  }
  {
    // the refined point must lie on (just behind) the visible surface: a ray that went behind an object
    // (the far side is not in the depth buffer) is a miss, not a stretched copy of the object's front
    vec3 Q = P + R * hi;
    float sd = fetchDepth(ivec2(project(Q)));
    float dz = validDepth(sd) ? Q.z - viewZ(sd) : 1e9;
    float tol = max(pc.par.y, 0.02 * Q.z) + abs(R.z) * (hi - lo) * 2.0;
    if (dz < 0.0 || dz > tol) { outp[i] = 0u; return; }
  }
  vec3 Qh = P + R * hi;
  vec2 hp = project(Qh);
  {
    // 0.13.11: the hit surface must face the ray. A wall's ray coming back towards the camera reaches a character
    // standing in front of it from behind; only the character's back is on screen, which the wall cannot see
    // (it showed as an outline ghost on the marble walls). Same test drops back faces seen by floor rays.
    ivec2 h = ivec2(hp);
    vec2 hc = vec2(h) + 0.5;
    float d0 = fetchDepth(h), dl = fetchDepth(h + ivec2(-1, 0)), dr = fetchDepth(h + ivec2(1, 0));
    float du = fetchDepth(h + ivec2(0, -1)), dd = fetchDepth(h + ivec2(0, 1));
    if (validDepth(d0)) {
      vec3 H0 = viewPos(hc, viewZ(d0));
      vec3 Hl = viewPos(hc + vec2(-1, 0), viewZ(validDepth(dl) ? dl : d0)), Hr = viewPos(hc + vec2(1, 0), viewZ(validDepth(dr) ? dr : d0));
      vec3 Hu = viewPos(hc + vec2(0, -1), viewZ(validDepth(du) ? du : d0)), Hd = viewPos(hc + vec2(0, 1), viewZ(validDepth(dd) ? dd : d0));
      vec3 hx = abs(Hr.z - H0.z) < abs(H0.z - Hl.z) ? Hr - H0 : H0 - Hl;
      vec3 hy = abs(Hd.z - H0.z) < abs(H0.z - Hu.z) ? Hd - H0 : H0 - Hu;
      vec3 Nh = normalize(cross(hx, hy));
      if (dot(Nh, normalize(H0)) > 0.0) Nh = -Nh;     // towards the camera (the side that is on screen)
      // silhouette edges (a neighbour far behind or in front) have no usable normal: the outline of a character
      // standing in front of a wall was still reflected there (0.13.11 screenshot)
      float z0 = H0.z, tolE = 0.03 * z0 + 20.0;
      bool edge = abs(Hl.z - z0) > tolE || abs(Hr.z - z0) > tolE || abs(Hu.z - z0) > tolE || abs(Hd.z - z0) > tolE;
      if (edge || dot(Nh, R) > -0.1) { outp[i] = 0u; return; }
    }
  }
  // rough surfaces: wider footprint, growing with the distance travelled
  float rad = rough * (1.0 + 0.012 * hi) * pc.vp.w / 720.0;
  vec3 col = fetchColor(ivec2(hp));
  if (rad >= 1.0) {
    col += fetchColor(ivec2(hp + vec2(rad, 0))) + fetchColor(ivec2(hp - vec2(rad, 0)))
         + fetchColor(ivec2(hp + vec2(0, rad))) + fetchColor(ivec2(hp - vec2(0, rad)));
    col /= 5.0;
  }
  // fades: screen edges, ray length, rays coming back towards the camera, surface angle (Fresnel-like)
  vec2 e = min(hp - pc.vp.xy, pc.vp.xy + pc.vp.zw - hp) / (0.08 * pc.vp.zw);
  float edge = clamp(min(e.x, e.y), 0.0, 1.0);
  float lenFade = 1.0 - smoothstep(0.6, 1.0, hi / maxT);   // 0.13.7: full strength for most of the ray (was linear)
  float toward = clamp(1.0 + R.z * 2.0, 0.0, 1.0);
  float cosv = clamp(dot(N, -V), 0.0, 1.0);
  float fres = 0.6 + 0.4 * pow(1.0 - cosv, 3.0);         // 0.13.4: polished stone reflects well head-on too
  float a = strength * pc.par.z * fres * edge * lenFade * toward * (1.0 - 0.5 * rough);
  if (pc.fog.z > 0.5 && pc.fog.y > pc.fog.x) a *= clamp((pc.fog.y - P.z) / (pc.fog.y - pc.fog.x), 0.0, 1.0);
  if (pc.fog.w > 0.5) { col = vec3(1.0, 0.0, 1.0); a = strength; }   // debug: show the mask
  uint ai = uint(clamp(a, 0.0, 1.0) * 255.0 + 0.5);
  uvec3 ci = uvec3(clamp(col, 0.0, 1.0) * 255.0 + 0.5);
  outp[i] = ci.b | (ci.g << 8u) | (ci.r << 16u) | (ai << 24u);
}
