#version 450
// Lebensbaum texture super-resolution: a compact Real-ESRGAN network (SRVGGNetCompact, "realesr-general-x4v3"
// blended with its denoising variant; BSD-3-Clause, Xintao Wang) run on the GPU over each game texture after it
// has been uploaded. 34 3x3 convolutions (3 -> 64 -> ... -> 48 channels, PReLU), pixel shuffle x4, plus the input
// enlarged. The result is colour-corrected back to the original: every source texel keeps its own average colour
// and only finer detail comes from the network, so the game's look is kept. Wrap padding (textures tile).
//
// modes: 0 decode raw -> src (straight RGBA), 1 fill transparent texels' colour from opaque neighbours -> act
// planes (network input), 2 convolution (act in -> act out, 16 output channels per invocation, z = group),
// 3 colour correction per source texel, 4 pack the final image (4x, or 2x by averaging) into the device format.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer RawBuf    { uint raw[]; };
layout(binding = 1, std430) readonly buffer WeightBuf { float wts[]; };
layout(binding = 2, std430) readonly buffer ActIn     { float actIn[]; };
layout(binding = 3, std430)          buffer ActOut    { float actOut[]; };
layout(binding = 4, std430)          buffer SrcBuf    { vec4 src[]; };
layout(binding = 5, std430)          buffer CorrBuf   { vec4 corr[]; };
layout(binding = 6, std430) writeonly buffer OutBuf   { uint outp[]; };

layout(push_constant) uniform PC {
  uvec4 a;     // w, h (source), mode, format
  uvec4 b;     // conv: cin, cout, prelu, weight offset | pack: output scale (2 / 4), opaque flag
  uvec4 c;     // conv: bias offset, prelu offset | act offsets: input-image plane offset, final act offset
} pc;

uint W() { return pc.a.x; }
uint H() { return pc.a.y; }
uint N() { return pc.a.x * pc.a.y; }
ivec2 wrapc(ivec2 p) { return ivec2(uint(p.x + 4096 * int(W())) % W(), uint(p.y + 4096 * int(H())) % H()); }
uint idx(ivec2 p) { p = wrapc(p); return uint(p.y) * W() + uint(p.x); }

vec4 decode(uint i) {
  uint f = pc.a.w;
  if (f <= 1u) {
    vec4 c = unpackUnorm4x8(raw[i]);
    return f == 0u ? c.bgra : c;
  }
  uint t = (raw[i >> 1] >> ((i & 1u) * 16u)) & 0xFFFFu;
  if (f == 2u) return vec4(float((t >> 10) & 31u) / 31.0, float((t >> 5) & 31u) / 31.0, float(t & 31u) / 31.0, float(t >> 15));
  if (f == 3u) return vec4(float(t >> 11) / 31.0, float((t >> 5) & 63u) / 63.0, float(t & 31u) / 31.0, 1.0);
  if (f == 4u) return vec4(float((t >> 8) & 15u), float((t >> 4) & 15u), float(t & 15u), float(t >> 12)) / 15.0;
  if (f == 5u) return vec4(float((t >> 4) & 15u), float((t >> 8) & 15u), float(t >> 12), float(t & 15u)) / 15.0;
  if (f == 6u) return vec4(float(t >> 12), float((t >> 8) & 15u), float((t >> 4) & 15u), float(t & 15u)) / 15.0;
  if (f == 7u) return vec4(float((t >> 1) & 31u) / 31.0, float((t >> 6) & 31u) / 31.0, float(t >> 11) / 31.0, float(t & 1u));
  if (f == 8u) return vec4(float(t & 31u) / 31.0, float((t >> 5) & 63u) / 63.0, float(t >> 11) / 31.0, 1.0);
  return vec4(0.5);
}
uint q(float v, float m) { return uint(clamp(v, 0.0, 1.0) * m + 0.5); }
uint encode16(vec4 c) {
  uint f = pc.a.w;
  if (f == 2u) return (c.a >= 0.5 ? 0x8000u : 0u) | (q(c.r, 31.0) << 10) | (q(c.g, 31.0) << 5) | q(c.b, 31.0);
  if (f == 3u) return (q(c.r, 31.0) << 11) | (q(c.g, 63.0) << 5) | q(c.b, 31.0);
  if (f == 4u) return (q(c.a, 15.0) << 12) | (q(c.r, 15.0) << 8) | (q(c.g, 15.0) << 4) | q(c.b, 15.0);
  if (f == 5u) return (q(c.b, 15.0) << 12) | (q(c.g, 15.0) << 8) | (q(c.r, 15.0) << 4) | q(c.a, 15.0);
  if (f == 6u) return (q(c.r, 15.0) << 12) | (q(c.g, 15.0) << 8) | (q(c.b, 15.0) << 4) | q(c.a, 15.0);
  if (f == 7u) return (q(c.b, 31.0) << 11) | (q(c.g, 31.0) << 6) | (q(c.r, 31.0) << 1) | (c.a >= 0.5 ? 1u : 0u);
  if (f == 8u) return (q(c.b, 31.0) << 11) | (q(c.g, 63.0) << 5) | q(c.r, 31.0);
  return 0u;
}

// convolution tiles: a workgroup (8x8 invocations) covers 16x16 pixels, each invocation a 2x2 block of pixels
// for 16 output channels; input channels in chunks of 8 (18x18 tile + their weights in shared memory)
shared float sTile[8][18][18];
shared float sW[16][8][9];

// network output at a 4x pixel: pixel shuffle of the last 48 channels + the input (nearest)
vec3 sr4(ivec2 p4) {
  ivec2 s = p4 >> 2; ivec2 sub = p4 & 3;
  uint i = idx(s);
  uint k = uint(sub.y * 4 + sub.x);
  uint fo = pc.c.w, io = pc.c.z;
  return vec3(actIn[fo + (0u * 16u + k) * N() + i] + actIn[io + 0u * N() + i],
              actIn[fo + (1u * 16u + k) * N() + i] + actIn[io + 1u * N() + i],
              actIn[fo + (2u * 16u + k) * N() + i] + actIn[io + 2u * N() + i]);
}
vec4 bilinearSrc(vec2 sp, bool useCorr) {   // sp in source texels
  vec2 f = sp - 0.5; ivec2 b = ivec2(floor(f)); f -= vec2(b);
  vec4 a = useCorr ? corr[idx(b)] : src[idx(b)], c = useCorr ? corr[idx(b + ivec2(1, 0))] : src[idx(b + ivec2(1, 0))];
  vec4 d = useCorr ? corr[idx(b + ivec2(0, 1))] : src[idx(b + ivec2(0, 1))], e = useCorr ? corr[idx(b + ivec2(1, 1))] : src[idx(b + ivec2(1, 1))];
  return mix(mix(a, c, f.x), mix(d, e, f.x), f.y);
}
vec4 finalAt(ivec2 p4) {
  vec2 sp = (vec2(p4) + 0.5) / 4.0;
  vec3 rgb = sr4(p4) + bilinearSrc(sp, true).rgb;
  float a = bilinearSrc(sp, false).a;
  return vec4(clamp(rgb, 0.0, 1.0), a);
}

void main() {
  uvec3 g = gl_GlobalInvocationID;
  uint mode = pc.a.z;

  if (mode == 2u) {                                         // convolution (grid: 16x16 pixels per workgroup)
    uint cin = pc.b.x, cout = pc.b.y, wo = pc.b.w;
    uint o0 = gl_WorkGroupID.z * 16u;
    ivec2 base = ivec2(gl_WorkGroupID.xy) * 16 - 1;
    uint lid = gl_LocalInvocationIndex;
    uvec2 l = gl_LocalInvocationID.xy * 2u;
    float acc[4][16];
    for (int o = 0; o < 16; o++) {
      float b = (o0 + uint(o) < cout) ? wts[pc.c.x + o0 + uint(o)] : 0.0;
      acc[0][o] = b; acc[1][o] = b; acc[2][o] = b; acc[3][o] = b;
    }
    for (uint c0 = 0u; c0 < cin; c0 += 8u) {
      uint cn = min(8u, cin - c0);
      for (uint t = lid; t < 8u * 324u; t += 64u) {
        uint cc = t / 324u, r = t % 324u;
        ivec2 p = base + ivec2(int(r % 18u), int(r / 18u));
        sTile[cc][r / 18u][r % 18u] = cc < cn ? actIn[(c0 + cc) * N() + idx(p)] : 0.0;
      }
      for (uint t = lid; t < 16u * 8u * 9u; t += 64u) {
        uint oo = t / 72u, rem = t % 72u, cc = rem / 9u, k = rem % 9u;
        sW[oo][cc][k] = (oo + o0 < cout && cc < cn) ? wts[wo + ((o0 + oo) * cin + c0 + cc) * 9u + k] : 0.0;
      }
      barrier();
      for (uint cc = 0u; cc < cn; cc++) {
        float v[4][4];
        for (uint y = 0u; y < 4u; y++) for (uint x = 0u; x < 4u; x++) v[y][x] = sTile[cc][l.y + y][l.x + x];
        for (int o = 0; o < 16; o++) {
          float w0 = sW[o][cc][0], w1 = sW[o][cc][1], w2 = sW[o][cc][2], w3 = sW[o][cc][3], w4 = sW[o][cc][4];
          float w5 = sW[o][cc][5], w6 = sW[o][cc][6], w7 = sW[o][cc][7], w8 = sW[o][cc][8];
          for (uint q = 0u; q < 4u; q++) {
            uint qy = q >> 1, qx = q & 1u;
            acc[q][o] += w0 * v[qy][qx] + w1 * v[qy][qx + 1u] + w2 * v[qy][qx + 2u]
                       + w3 * v[qy + 1u][qx] + w4 * v[qy + 1u][qx + 1u] + w5 * v[qy + 1u][qx + 2u]
                       + w6 * v[qy + 2u][qx] + w7 * v[qy + 2u][qx + 1u] + w8 * v[qy + 2u][qx + 2u];
          }
        }
      }
      barrier();
    }
    for (uint q = 0u; q < 4u; q++) {
      uvec2 px = gl_WorkGroupID.xy * 16u + l + uvec2(q & 1u, q >> 1);
      if (px.x >= W() || px.y >= H()) continue;
      uint i = px.y * W() + px.x;
      for (int o = 0; o < 16; o++) {
        uint oc = o0 + uint(o);
        if (oc >= cout) break;
        float x = acc[q][o];
        if (pc.b.z != 0u && x < 0.0) x *= wts[pc.c.y + oc];
        actOut[oc * N() + i] = x;
      }
    }
    return;
  }

  if (mode == 4u) {                                         // pack (grid = output size)
    uint sc = pc.b.x;
    uint ow = W() * sc, oh = H() * sc;
    bool opaque = (pc.b.y & 1u) != 0u;
    uint f = pc.a.w;
    uint px = f <= 1u ? g.x : g.x * 2u;
    if (px >= ow || g.y >= oh) return;
    vec4 cs[2];
    for (uint k = 0u; k < (f <= 1u ? 1u : 2u); k++) {
      ivec2 p = ivec2(px + k, g.y);
      vec4 c;
      if (sc == 4u) c = finalAt(p);
      else if (sc == 2u) c = 0.25 * (finalAt(p * 2) + finalAt(p * 2 + ivec2(1, 0)) + finalAt(p * 2 + ivec2(0, 1)) + finalAt(p * 2 + ivec2(1, 1)));
      else {                                                 // 3x: bilinear from the 4x result
        vec2 qf = (vec2(p) + 0.5) * (4.0 / float(sc)) - 0.5;
        ivec2 b0 = ivec2(floor(qf)); vec2 t = qf - vec2(b0);
        ivec2 m = ivec2(W(), H()) * 4;
        ivec2 q00 = ivec2(uint(b0.x + 4 * m.x) % uint(m.x), uint(b0.y + 4 * m.y) % uint(m.y));
        ivec2 q11 = ivec2(uint(b0.x + 1 + 4 * m.x) % uint(m.x), uint(b0.y + 1 + 4 * m.y) % uint(m.y));
        c = mix(mix(finalAt(q00), finalAt(ivec2(q11.x, q00.y)), t.x), mix(finalAt(ivec2(q00.x, q11.y)), finalAt(q11), t.x), t.y);
      }
      if (opaque) c.a = 1.0;
      cs[k] = c;
    }
    uint i = g.y * ow + px;
    if (f <= 1u) outp[i] = packUnorm4x8(f == 0u ? cs[0].bgra : cs[0]);
    else outp[i >> 1] = encode16(cs[0]) | (encode16(cs[1]) << 16);
    return;
  }

  if (g.x >= W() || g.y >= H()) return;
  ivec2 p = ivec2(g.xy);
  uint i = g.y * W() + g.x;

  if (mode == 0u) {                                         // decode
    vec4 c = decode(i);
    if ((pc.b.y & 1u) != 0u) c.a = 1.0;
    src[i] = c;
  } else if (mode == 1u) {                                  // network input: colour of see-through texels from neighbours
    vec4 c = src[i];
    vec3 rgb = c.rgb;
    if (c.a < 0.5) {
      vec3 s = vec3(0.0); float n = 0.0;
      for (int y = -2; y <= 2; y++) for (int x = -2; x <= 2; x++) {
        vec4 o = src[idx(p + ivec2(x, y))];
        if (o.a >= 0.5) { float w = 1.0 / (1.0 + float(x * x + y * y)); s += w * o.rgb; n += w; }
      }
      if (n > 0.0) rgb = s / n;
    }
    for (uint k = 0u; k < 3u; k++) actOut[pc.c.z + k * N() + i] = rgb[k];
  } else if (mode == 3u) {                                  // correction: original minus the network's block average
    vec3 s = vec3(0.0);
    for (int y = 0; y < 4; y++) for (int x = 0; x < 4; x++) s += clamp(sr4(p * 4 + ivec2(x, y)), 0.0, 1.0);
    vec3 orig = actIn[pc.c.z + 0u * N() + i] * vec3(1.0, 0.0, 0.0) + actIn[pc.c.z + 1u * N() + i] * vec3(0.0, 1.0, 0.0)
              + actIn[pc.c.z + 2u * N() + i] * vec3(0.0, 0.0, 1.0);
    corr[i] = vec4(orig - s / 16.0, 0.0);
  }
}
